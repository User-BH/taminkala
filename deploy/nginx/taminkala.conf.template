# ==========================================================
#  تأمین کالا باختر — پیکربندی Nginx
#  طراحی و توسعه: شرکت رهوار پیوند داده
#  ⚠ این فایل توسط deploy/taminkala.sh ساخته می‌شود؛ مستقیم ویرایش نکنید.
#    برای تغییر پورت‌ها و مسیرها:  sudo taminkala  ←  گزینه «تنظیمات»
#
#  یک آدرس، سه سرویس روی سه پورت جدا:
#    :{{SITE_PORT}}  سایت معرفی شرکت
#    :{{PICHAK_PORT}}  سامانه پیچک (استعلام چک)  → {{PICHAK_UPSTREAM}}
#    :{{BIME_PORT}}  سامانه بیمه و حواله
#
#  هیچ مسیری در سایت اصلی به سامانه‌ها نمی‌رسد؛ مثلاً /pichak یا /bime
#  صفحه ۴۰۴ با قالب تأمین کالا را نشان می‌دهد.
# ==========================================================

# ----------------------------------------------------------
#  ۱) سایت معرفی شرکت
# ----------------------------------------------------------
server {
    listen {{SITE_PORT}} default_server;
    listen [::]:{{SITE_PORT}} default_server;
    server_name {{SERVER_NAME}};

    root {{SITE_ROOT}};
    index index.html;
    server_tokens off;
    charset utf-8;

    include /etc/nginx/snippets/taminkala-common.conf;

    location / {
        # فقط فایل‌های موجود؛ هر مسیر دیگری (از جمله /pichak و /bime) → ۴۰۴
        try_files $uri $uri/ =404;
    }

    location /assets/ {
        expires 30d;
        try_files $uri =404;
    }
}

# ----------------------------------------------------------
#  ۲) سامانه پیچک — استعلام وضعیت چک (برنامه در /opt/pichak)
# ----------------------------------------------------------
server {
    listen {{PICHAK_PORT}};
    listen [::]:{{PICHAK_PORT}};
    server_name {{SERVER_NAME}};
    server_tokens off;

    include /etc/nginx/snippets/taminkala-common.conf;

    # فایل‌های قالب برای صفحه ۴۰۴ (پیچک مسیر /assets ندارد)
    location /assets/ { root {{SITE_ROOT}}; try_files $uri =404; }

    # API: پاسخ‌های JSON خود برنامه بدون تغییر برگردانده می‌شوند
    location /api/ {
        proxy_pass http://{{PICHAK_UPSTREAM}};
        include /etc/nginx/snippets/taminkala-proxy.conf;
    }

    # صفحه و فایل‌های استاتیک پیچک؛ ۴۰۴ برنامه با ۴۰۴ قالب تأمین کالا جایگزین می‌شود
    location / {
        proxy_pass http://{{PICHAK_UPSTREAM}};
        include /etc/nginx/snippets/taminkala-proxy.conf;
        proxy_intercept_errors on;
    }
}

# ----------------------------------------------------------
#  ۳) سامانه بیمه و حواله
# ----------------------------------------------------------
server {
    listen {{BIME_PORT}};
    listen [::]:{{BIME_PORT}};
    server_name {{SERVER_NAME}};
    server_tokens off;

    root {{BIME_ROOT}};
    index index.html;
    charset utf-8;

    include /etc/nginx/snippets/taminkala-common.conf;

    location /assets/ { root {{SITE_ROOT}}; try_files $uri =404; }

    location / {
        try_files $uri $uri/ =404;
        expires -1;                    # همیشه آخرین نسخه سامانه
    }
}
